              "type": {
                "text": "Segment[]"
              },
              "readonly": true
            },
            {
              "kind": "field",
              "name": "selectedSegment",
              "description": "The selected <gc-segment>, or null.",
              "type": {
                "text": "Segment | null"
              },
              "readonly": true
            },
            {
              "kind": "field",
              "name": "selectedIndex",
              "description": "Index of the selected segment among `segments`, or -1. Setting it fires no event.",
              "type": {
                "text": "number"
              }
            },
            {
              "kind": "field",
              "name": "orientation",
              "type": {
                "text": "'horizontal' | 'vertical'"
              },
              "default": "'horizontal'",
              "reflects": true,
              "attribute": "orientation"
            },
            {
              "kind": "field",
              "name": "type",
              "type": {
                "text": "'gc-segmented-control'"
              },
              "readonly": true
            },
            {
              "kind": "method",
              "name": "focus",
              "parameters": [
                {
                  "name": "options"
                }
              ],
              "description": "Focuses the selected segment (or the first enabled one), as the Tab key would."
            },
            {
              "kind": "field",
              "name": "formAssociated",
              "type": {
                "text": "boolean"
              },
              "static": true,
              "default": "true"
            },
            {
              "kind": "field",
              "name": "disabled",
              "type": {
                "text": "boolean"
              },
              "default": "false",
              "reflects": true,
              "attribute": "disabled"
            },
            {
              "kind": "field",
              "name": "required",
              "type": {
                "text": "boolean"
              },
              "default": "false",
              "reflects": true,
              "attribute": "required"
            },
            {
              "kind": "field",
              "name": "name",
              "type": {
                "text": "string"
              },
              "default": "\"\"",
              "reflects": true,
              "attribute": "name"
            },
            {
              "kind": "field",
              "name": "form",
              "type": {
                "text": "HTMLFormElement | null"
              },
              "readonly": true
            },
            {
              "kind": "field",
              "name": "labels",
              "type": {
                "text": "NodeList"
              },
              "readonly": true
            },
            {
              "kind": "field",
              "name": "validity",
              "type": {
                "text": "ValidityState"
              },
              "readonly": true
            },
            {
              "kind": "field",
              "name": "validationMessage",
              "type": {
                "text": "string"
              },
              "readonly": true
            },
            {
              "kind": "field",
              "name": "willValidate",
              "type": {
                "text": "boolean"
              },
              "readonly": true
            },
            {
              "kind": "method",
              "name": "checkValidity",
              "return": {
                "type": {
                  "text": "boolean"
                }
              }
            },
            {
              "kind": "method",
              "name": "reportValidity",
              "return": {
                "type": {
                  "text": "boolean"
                }
              }
            },
            {
              "kind": "method",
              "name": "setCustomValidity",
              "parameters": [
                {
                  "name": "message",
                  "description": "An empty string clears the custom error.",
                  "type": {
                    "text": "string"
                  }
                }
              ],
              "return": {
                "type": {
                  "text": "void"
                }
              }
            }
          ],
          "events": [
            {
              "name": "input",
              "type": {
                "text": "Event"
              },
              "description": "The user selected another segment. Bubbles and is composed."
            },
            {
              "name": "change",
              "type": {
                "text": "Event"
              },
              "description": "Right after input. Bubbles."
            }
          ],
          "attributes": [
            {
              "name": "value",
              "type": {
                "text": "string"
              },
              "description": "Value of the selected segment. Also sets the default value used by form.reset().",
