  "modules": [
    {
      "kind": "javascript-module",
      "path": "gc-segmented-control.js",
      "declarations": [
        {
          "kind": "class",
          "description": "One option of a <gc-segmented-control>. Must be a direct child of the control.",
          "name": "Segment",
          "slots": [
            {
              "description": "The segment's content: text, icon, or both.",
              "name": ""
            }
          ],
          "members": [
            {
              "kind": "field",
              "name": "value",
              "description": "The value submitted when this segment is selected: the `value` attribute, or else the text content.",
              "type": {
                "text": "string"
              },
              "attribute": "value"
            },
            {
              "kind": "field",
              "name": "selected",
              "description": "Selecting a segment deselects the others. Fires no event.",
              "type": {
                "text": "boolean"
              },
              "default": "false",
              "reflects": true,
              "attribute": "selected"
            },
            {
              "kind": "field",
              "name": "disabled",
              "type": {
                "text": "boolean"
              },
              "default": "false",
              "reflects": true,
              "attribute": "disabled"
            },
            {
              "kind": "field",
              "name": "control",
              "description": "The <gc-segmented-control> this segment belongs to (its parent), if any.",
              "type": {
                "text": "SegmentedControl | null"
              },
              "readonly": true
            }
          ],
          "attributes": [
            {
              "name": "selected",
              "type": {
                "text": "boolean"
              },
              "description": "Reflected selection state. Selecting one segment deselects the others.",
              "fieldName": "selected",
              "default": "false"
            },
            {
              "name": "disabled",
              "type": {
                "text": "boolean"
              },
              "description": "The segment cannot be selected and is skipped by the arrow keys.",
              "fieldName": "disabled",
              "default": "false"
            },
            {
              "name": "value",
              "type": {
                "text": "string"
              },
              "description": "Value submitted when selected. Defaults to the text content.",
              "fieldName": "value"
            }
          ],
          "cssStates": [
            {
              "description": "The segment is selected.",
              "name": "selected"
            },
            {
              "description": "The segment, or its whole control, is disabled.",
              "name": "disabled"
            }
          ],
          "superclass": {
            "name": "HTMLElement",
            "package": "global:"
          },
          "tagName": "gc-segment",
          "customElement": true,
          "summary": "An option of a segmented control (role \"radio\")."
        },
        {
          "kind": "class",
          "description": "An accessible, form-associated segmented control (role \"radiogroup\").",
          "name": "SegmentedControl",
          "cssProperties": [
            {
              "description": "Track background.",
              "name": "--segmented-background"
            },
            {
              "description": "Track border (shorthand).",
              "name": "--segmented-border"
            },
            {
              "description": "Text colour of the segments.",
              "name": "--segmented-color"
            },
            {
              "description": "Text colour of the selected segment.",
              "name": "--segmented-selected-color"
            },
            {
              "description": "Background of the selection indicator.",
              "name": "--segmented-indicator-color"
            },
            {
              "description": "Shadow of the selection indicator.",
              "name": "--segmented-indicator-shadow"
            },
            {
              "description": "Background of a hovered segment.",
              "name": "--segmented-hover-color"
            },
            {
              "description": "Outer corner radius.",
              "name": "--segmented-radius",
              "default": "0.5em"
            },
            {
              "description": "Gap between the track edge and the segments.",
              "name": "--segmented-padding",
              "default": "0.1875em"
            },
            {
              "description": "Gap between two segments.",
              "name": "--segmented-gap",
              "default": "0.125em"
            },
            {
              "description": "Inner padding of each segment.",
              "name": "--segmented-segment-padding",
              "default": "0.375em 0.875em"
            },
            {
              "description": "Focus ring colour.",
              "name": "--segmented-focus-color"
            },
            {
              "description": "Animation duration.",
              "name": "--segmented-duration",
              "default": "200ms"
            }
          ],
          "cssParts": [
            {
              "description": "The container: background, border, grid of segments.",
              "name": "track"
            },
            {
              "description": "The sliding selection indicator.",
              "name": "indicator"
            }
          ],
          "slots": [
            {
              "description": "The <gc-segment> options.",
              "name": ""
            }
          ],
          "members": [
            {
              "kind": "method",
              "name": "registerMessages",
              "static": true,
              "parameters": [
                {
                  "name": "lang",
                  "type": {
                    "text": "string"
                  }
                },
                {
                  "name": "entries",
                  "type": {
                    "text": "{ valueMissing?: string }"
                  }
                }
              ],
              "description": "Adds or overrides the built-in messages for a language, e.g.\n`SegmentedControl.registerMessages('de', { valueMissing: 'Bitte wählen Sie eine Option.' })`.\nThe language comes from the closest `lang` attribute, else the browser."
            },
            {
              "kind": "field",
              "name": "value",
              "description": "Value of the selected segment, or \"\" when none is selected. Setting it fires no event.",
              "type": {
                "text": "string"
              },
              "attribute": "value"
            },
            {
              "kind": "field",
              "name": "defaultValue",
              "description": "Value restored by form.reset().",
              "type": {
                "text": "string"
              }
            },
            {
              "kind": "field",
              "name": "segments",
