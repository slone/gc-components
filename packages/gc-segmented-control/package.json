{
  "name": "gc-segmented-control",
  "version": "0.1.0",
  "description": "Accessible segmented control: a native, dependency-free, form-associated Custom Element.",
  "type": "module",
  "main": "gc-segmented-control.js",
  "module": "gc-segmented-control.js",
  "types": "gc-segmented-control.d.ts",
  "customElements": "custom-elements.json",
  "exports": {
    ".": {
      "types": "./gc-segmented-control.d.ts",
      "default": "./gc-segmented-control.js"
    },
    "./custom-elements.json": "./custom-elements.json",
    "./vscode.html-custom-data.json": "./vscode.html-custom-data.json"
  },
  "files": [
    "gc-segmented-control.js",
    "gc-segmented-control.d.ts",
    "custom-elements.json",
    "vscode.html-custom-data.json",
    "README.fr.md"
  ],
  "scripts": {
    "analyze": "cem analyze --config ../../custom-elements-manifest.config.mjs",
    "prepack": "npm run analyze && node ../../tools/pack.mjs prepack",
    "postpack": "node ../../tools/pack.mjs postpack"
  },
  "keywords": [
    "web-component",
    "custom-element",
    "segmented-control",
    "segmented-button",
    "button-group",
    "radiogroup",
    "gc-segmented-control",
    "form-associated",
    "accessibility",
    "a11y"
  ],
  "author": "Chantraine.net",
  "license": "MIT",
  "homepage": "https://github.com/slone/gc-components/tree/main/packages/gc-segmented-control#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/slone/gc-components.git",
    "directory": "packages/gc-segmented-control"
  },
  "bugs": {
    "url": "https://github.com/slone/gc-components/issues"
  }
}
