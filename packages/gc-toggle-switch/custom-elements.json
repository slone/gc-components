{
  "schemaVersion": "1.0.0",
  "readme": "",
  "modules": [
    {
      "kind": "javascript-module",
      "path": "gc-toggle-switch.js",
      "declarations": [
        {
          "kind": "class",
          "description": "An on/off switch, horizontal or vertical, usable with a pointer (click or drag) and the keyboard (Space, Enter).",
          "name": "ToggleSwitch",
          "cssProperties": [
            {
              "description": "Track colour when off.",
              "name": "--switch-off-color",
              "default": "light-dark(#767676, #8e8e93)"
            },
            {
              "description": "Track colour when on.",
              "name": "--switch-on-color",
              "default": "light-dark(#1a7f37, #2ea043)"
            },
            {
              "description": "Thumb colour.",
              "name": "--switch-thumb-color",
              "default": "#ffffff"
            },
            {
              "description": "Thumb shadow.",
              "name": "--switch-thumb-shadow",
              "default": "0 1px 3px rgb(0 0 0 / 0.35), 0 0 0 0.5px rgb(0 0 0 / 0.08)"
            },
            {
              "description": "Thumb diameter.",
              "name": "--switch-thumb-size",
              "default": "1.25em"
            },
            {
              "description": "Gap between the thumb and the track edge.",
              "name": "--switch-padding",
              "default": "0.1875em"
            },
            {
              "description": "Track length (long side).",
              "name": "--switch-length",
              "default": "1.65 × the track width"
            },
            {
              "description": "Focus ring colour.",
              "name": "--switch-focus-color",
              "default": "light-dark(#0b57d0, #a8c7fa)"
            },
            {
              "description": "State indicator colour.",
              "name": "--switch-label-color",
              "default": "#ffffff"
            },
            {
              "description": "Halo around the thumb on hover and press.",
              "name": "--switch-halo-color",
              "default": "light-dark(rgb(0 0 0 / 0.1), rgb(255 255 255 / 0.18))"
            },
            {
              "description": "Animation duration.",
              "name": "--switch-duration",
              "default": "180ms"
            },
            {
              "description": "0 = horizontal, 1 = vertical. The orientation attribute wins.",
              "name": "--switch-vertical",
              "default": "0"
            }
          ],
          "cssParts": [
            {
              "description": "The track (rounded background).",
              "name": "track"
            },
            {
              "description": "The round thumb.",
              "name": "thumb"
            },
            {
              "description": "The indicator shown when on.",
              "name": "on-label"
            },
            {
              "description": "The indicator shown when off.",
              "name": "off-label"
            }
          ],
          "slots": [
            {
              "description": "Indicator shown when on (short text or icon).",
              "name": "on"
            },
            {
              "description": "Indicator shown when off (short text or icon).",
              "name": "off"
            }
          ],
          "members": [
            {
              "kind": "method",
              "name": "registerMessages",
              "static": true,
              "parameters": [
                {
                  "name": "lang",
                  "type": {
                    "text": "string"
                  }
                },
                {
                  "name": "entries",
                  "type": {
                    "text": "{ valueMissing?: string }"
                  }
                }
              ],
              "description": "Adds or overrides the built-in messages for a language, e.g.\n`ToggleSwitch.registerMessages('de', { valueMissing: 'Bitte einschalten.' })`.\nThe language comes from the closest `lang` attribute, else the browser."
            },
            {
              "kind": "field",
              "name": "checked",
              "description": "Current state. Setting it fires no event.",
              "type": {
                "text": "boolean"
              },
              "default": "false",
              "reflects": true,
              "attribute": "checked"
            },
            {
              "kind": "field",
              "name": "defaultChecked",
              "description": "State restored by form.reset().",
              "type": {
                "text": "boolean"
              },
              "default": "false"
            },
            {
              "kind": "field",
              "name": "busy",
              "type": {
                "text": "boolean"
              },
              "default": "false",
              "reflects": true,
              "attribute": "busy"
            },
            {
              "kind": "field",
              "name": "value",
              "type": {
                "text": "string"
              },
              "default": "\"on\"",
              "reflects": true,
              "attribute": "value"
            },
            {
              "kind": "field",
              "name": "orientation",
              "description": "Orientation set by the attribute; an orientation set in CSS is not visible here.",
              "type": {
                "text": "'horizontal' | 'vertical'"
              },
              "default": "\"horizontal\"",
              "reflects": true,
              "attribute": "orientation"
            },
            {
              "kind": "field",
              "name": "stateLabels",
              "type": {
                "text": "boolean"
              },
              "default": "false",
              "reflects": true,
              "attribute": "state-labels"
            },
            {
              "kind": "field",
              "name": "type",
              "type": {
                "text": "'gc-toggle-switch'"
              },
              "readonly": true
            },
            {
              "kind": "method",
              "name": "toggle",
              "parameters": [
                {
                  "name": "force",
                  "optional": true,
                  "type": {
                    "text": "boolean"
                  }
                }
              ],
              "description": "Toggles the state, or sets it when force is a boolean. Fires no event.",
              "return": {
                "type": {
                  "text": "boolean"
                }
              }
            },
            {
              "kind": "field",
              "name": "formAssociated",
              "type": {
                "text": "boolean"
              },
              "static": true,
              "default": "true"
            },
            {
              "kind": "field",
              "name": "disabled",
              "type": {
                "text": "boolean"
              },
              "default": "false",
              "reflects": true,
              "attribute": "disabled"
            },
            {
              "kind": "field",
              "name": "required",
              "type": {
                "text": "boolean"
              },
              "default": "false",
              "reflects": true,
              "attribute": "required"
            },
            {
              "kind": "field",
              "name": "name",
              "type": {
                "text": "string"
              },
              "default": "\"\"",
              "reflects": true,
              "attribute": "name"
            },
            {
              "kind": "field",
              "name": "form",
              "type": {
                "text": "HTMLFormElement | null"
              },
              "readonly": true
            },
            {
              "kind": "field",
              "name": "labels",
              "type": {
                "text": "NodeList"
              },
              "readonly": true
            },
            {
              "kind": "field",
              "name": "validity",
              "type": {
                "text": "ValidityState"
              },
              "readonly": true
            },
            {
              "kind": "field",
              "name": "validationMessage",
              "type": {
                "text": "string"
              },
              "readonly": true
            },
            {
              "kind": "field",
              "name": "willValidate",
              "type": {
                "text": "boolean"
              },
              "readonly": true
            },
            {
              "kind": "method",
              "name": "checkValidity",
              "return": {
                "type": {
                  "text": "boolean"
                }
              }
            },
            {
              "kind": "method",
              "name": "reportValidity",
              "return": {
                "type": {
                  "text": "boolean"
                }
              }
            },
            {
              "kind": "method",
              "name": "setCustomValidity",
              "parameters": [
                {
                  "name": "message",
                  "description": "An empty string clears the custom error.",
                  "type": {
                    "text": "string"
                  }
                }
              ],
              "return": {
                "type": {
                  "text": "void"
                }
              }
            }
          ],
          "events": [
            {
              "type": {
                "text": "Event"
              },
              "description": "The user toggled the switch. Bubbles and is composed.",
              "name": "input"
            },
            {
              "type": {
                "text": "Event"
              },
              "description": "Fired right after input. Bubbles.",
              "name": "change"
            },
            {
              "type": {
                "text": "CustomEvent<{ oldChecked: boolean; newChecked: boolean }>"
              },
              "description": "Fired right after change, with the old and new states. Does not bubble.",
              "name": "toggle"
            }
          ],
          "attributes": [
            {
              "name": "checked",
              "type": {
                "text": "boolean"
              },
              "description": "The \"on\" state (reflected). Also sets the default state used by form.reset().",
              "fieldName": "checked",
              "default": "false"
            },
            {
              "name": "disabled",
              "type": {
                "text": "boolean"
              },
              "description": "Disables the switch and excludes it from the form.",
              "fieldName": "disabled",
              "default": "false"
            },
            {
              "name": "required",
              "type": {
                "text": "boolean"
              },
              "description": "The form is invalid while the switch is off.",
              "fieldName": "required",
              "default": "false"
            },
            {
              "name": "value",
              "type": {
                "text": "string"
              },
              "description": "Value submitted when the switch is on.",
              "fieldName": "value",
              "default": "\"on\""
            },
            {
              "name": "busy",
              "type": {
                "text": "boolean"
              },
              "description": "Shows a spinner, exposes aria-busy and ignores user actions.",
              "fieldName": "busy",
              "default": "false"
            },
            {
              "name": "off-color",
              "type": {
                "text": "string"
              },
              "description": "Track colour when off (any CSS colour). Wins over --switch-off-color."
            },
            {
              "name": "on-color",
              "type": {
                "text": "string"
              },
              "description": "Track colour when on (any CSS colour). Wins over --switch-on-color."
            },
            {
              "name": "state-labels",
              "type": {
                "text": "boolean"
              },
              "description": "Shows I / O state indicators in the track.",
              "fieldName": "stateLabels",
              "default": "false"
            },
            {
              "type": {
                "text": "string"
              },
              "description": "Field name in the form.",
              "name": "name",
              "fieldName": "name",
              "default": "\"\""
            },
            {
              "type": {
                "text": "'horizontal' | 'vertical'"
              },
              "description": "Orientation. Wins over --switch-vertical; horizontal when neither is set.",
              "name": "orientation",
              "fieldName": "orientation",
              "default": "\"horizontal\""
            }
          ],
          "cssStates": [
            {
              "description": "The switch is on.",
              "name": "checked"
            }
          ],
          "superclass": {
            "name": "HTMLElement",
            "package": "global:"
          },
          "tagName": "gc-toggle-switch",
          "customElement": true,
          "summary": "Accessible, form-associated toggle switch."
        }
      ],
      "exports": [
        {
          "kind": "js",
          "name": "ToggleSwitch",
          "declaration": {
            "name": "ToggleSwitch",
            "module": "gc-toggle-switch.js"
          }
        },
        {
          "kind": "custom-element-definition",
          "name": "gc-toggle-switch",
          "declaration": {
            "name": "ToggleSwitch",
            "module": "gc-toggle-switch.js"
          }
        }
      ]
    }
  ]
}
