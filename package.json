{
  "name": "gc-components",
  "private": true,
  "description": "Accessible, dependency-free, form-associated web components (gc-*).",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "playwright test",
    "test:chromium": "playwright test --project=chromium",
    "test:ui": "playwright test --ui",
    "analyze": "npm run analyze --workspaces --if-present",
    "check:generated": "npm run analyze && node tools/check-clean.mjs",
    "new": "node tools/new-component.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@playwright/test": "^1.65.1",
    "rollup": "^4.68.8"
  }
}
